# Occulus Configuration Environment Variables

# Database URL
DATABASE_URL=sqlite:///./storage/db/occulus.db

# Ultralytics YOLO Weights (Path to .pt weights or model name)
YOLO_MODEL_PATH=yolo11n.pt

# Default Inference Confidence Threshold (0.0 to 1.0)
DEFAULT_CONFIDENCE_THRESHOLD=0.25

# Video Sampling Interval in Seconds
VIDEO_SAMPLE_INTERVAL_SEC=1.0

# Maximum Media Upload Size in Megabytes
MAX_UPLOAD_SIZE_MB=150

# Server Host & Port
HOST=0.0.0.0
PORT=8000
